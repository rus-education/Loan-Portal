# ==============================================================================
# Git Ignore Configuration - Loan Management Portal
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
/.next/
/out/
/build

# Environment Variables & Secrets (CRITICAL: Do NOT commit)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Credentials, Keys, & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
credentials.json
service-account*.json

# Debug, Logs & Telemetry
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel Deployment Metadata
.vercel

# TypeScript & Linter Cache
*.tsbuildinfo
next-env.d.ts
.eslintcache

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Testing Coverage & Temporary Output
/coverage
scratch/
