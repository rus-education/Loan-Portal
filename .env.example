# ==============================================================================
# Enterprise Loan Management Portal - Environment Configuration Template
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
# Ensure Vercel serverless IPs (0.0.0.0/0) are permitted in Atlas Network Access.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-subdomain>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Authentication & Session Security (HS256 JWT)
# Minimum 32 characters high-entropy secret key
JWT_SECRET=replace-with-a-secure-random-32-character-secret-key-for-production
JWT_EXPIRES_IN=7d

# Application Configuration
NEXT_PUBLIC_APP_NAME="Loan Management Portal"
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app
NODE_ENV=production
